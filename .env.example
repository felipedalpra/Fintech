VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
APP_DATA_ENCRYPTION_KEY=uma-chave-forte-para-criptografar-perfis
# Opcional: se ausente, as credenciais dos provedores de cobrança usam APP_DATA_ENCRYPTION_KEY.
BILLING_DATA_ENCRYPTION_KEY=uma-chave-forte-exclusiva-para-credenciais-de-cobranca
OPENAI_API_KEY=sua-chave-openai
OPENAI_MODEL=gpt-4.1-mini
AI_ASSISTANT_DAILY_LIMIT=60
VITE_APP_URL=https://www.surgimetrics.com.br
APP_URL=https://www.surgimetrics.com.br
STRIPE_SECRET_KEY=sk_live_ou_sk_test
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_MENSAL=price_xxx
STRIPE_PRICE_SEMESTRAL=price_xxx
STRIPE_PRICE_ANUAL=price_xxx
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=https://www.surgimetrics.com.br/api/google/calendar
# Meta Ads — preencher somente quando o app Meta estiver pronto para ativação.
META_VERIFY_TOKEN=gere-um-token-aleatorio-forte
META_APP_SECRET=app-secret-do-meta
META_GRAPH_VERSION=vXX.X
# Evolution API — chave global somente no backend/Vercel; nunca usar prefixo VITE_.
EVOLUTION_API_BASE_URL=https://evolution.surgimetrics.com.br
EVOLUTION_API_KEY=gere-uma-chave-global-forte
EVOLUTION_REQUEST_TIMEOUT_MS=15000
WHATSAPP_WEBHOOK_BASE_URL=https://www.surgimetrics.com.br/api/whatsapp?action=webhook
# BRy Easy Sign — assinatura clínica ICP-Brasil. Somente backend; nunca usar
# prefixo VITE_. A flag fica FALSE até a homologação com a BRy terminar.
# Nunca cadastrar valores reais neste arquivo versionado.
BRY_EASY_SIGN_ENABLED=false
# Allowlist: https://easysign.hom.bry.com.br (homologação) ou
# https://easysign.bry.com.br (produção). Sem valor, a integração fica indisponível.
BRY_EASY_SIGN_BASE_URL=https://easysign.hom.bry.com.br
# Autenticação: o access_token da BRy dura POUCOS MINUTOS, então não existe JWT
# fixo. O backend troca client_id + client_secret por token a cada chamada e
# guarda em cache só enquanto vale (POST {cloud}/token-service/jwt).
# Ambas as credenciais saem da tela de aplicações do BRy Cloud.
BRY_EASY_SIGN_CLIENT_ID=uuid-da-aplicacao
BRY_EASY_SIGN_CLIENT_SECRET=api-key-da-aplicacao
# https://cloud.bry.com.br (produção) ou https://cloud-hom.bry.com.br (homologação).
BRY_EASY_SIGN_TOKEN_URL=https://cloud.bry.com.br
BRY_EASY_SIGN_TOKEN_TIMEOUT_MS=15000
# Só para o Quickstart de homologação, que envia o JWT por e-mail. Se
# client_id/client_secret estiverem configurados, eles vencem este valor.
# BRY_EASY_SIGN_TOKEN=
# UUID OPACO devolvido pelo cofre para referenciar o segredo. Não é o segredo.
BRY_EASY_SIGN_CREDENTIAL_ID=00000000-0000-4000-8000-000000000000
# SIMPLE | ADVANCED | QUALIFIED. Definir somente após a BRy confirmar o modo
# correto para documento médico (ver docs/BRY_EASY_SIGN_INTEGRATION.md).
BRY_EASY_SIGN_SIGNATURE_MODE=QUALIFIED
BRY_EASY_SIGN_SIGNATURE_PROFILE=TIMESTAMP
BRY_EASY_SIGN_HASH_ALGORITHM=SHA256
# Segredo de endpoint do webhook (mín. 32 caracteres). A BRy documenta
# authType NONE, então o callback é só notificação protegida por este segredo.
BRY_EASY_SIGN_WEBHOOK_SECRET=gere-um-segredo-aleatorio-de-40-caracteres
BRY_EASY_SIGN_REQUEST_TIMEOUT_MS=20000
# Verificação da assinatura (segunda API da BRy). É ela que devolve, em JSON,
# titular/série/emissor/validade do certificado e o instante da assinatura —
# a Easy Sign não devolve. Sem isto nenhuma tentativa pode virar "assinada".
# ATENÇÃO: o host oficial deste serviço ainda não está público (a documentação
# usa example.com); confirme com a BRy antes de preencher.
BRY_VERIFY_BASE_URL=
BRY_VERIFY_TOKEN=jwt-do-servico-de-verificacao
# Opcional: o padrão já é o caminho documentado.
BRY_VERIFY_PATH=/api/pdf-verification-service/v1/signatures/verify
BRY_VERIFY_REQUEST_TIMEOUT_MS=30000
